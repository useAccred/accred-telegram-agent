{
  "name": "accred-telegram-agent",
  "version": "0.1.0",
  "private": true,
  "description": "The Accred agent in Telegram: chat with any model, run jobs, control trading agents, get a daily brief.",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "git submodule update --init --recursive || true"
  },
  "dependencies": {
    "accred": "^0.1.0",
    "cron-parser": "^5.10.1",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "undici": "^8.11.2",
    "viem": "^2.57.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  }
}
