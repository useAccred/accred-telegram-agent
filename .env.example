# The same database as agent.accred.sh: a chat and the web app are one account.
DATABASE_URL=postgres://localhost:5432/accred_automation
# Must be the SAME value as the web app's APP_SECRET, or stored keys cannot be read.
APP_SECRET=
# Same as the web app's, when it has one. Needed to sign trades the chat asks for (close all).
TRADING_WALLET_SECRET=
# The bot from @BotFather. The web app must use the same token for sending, with TELEGRAM_POLLING=off.
TELEGRAM_BOT_TOKEN=
# "on" to let the chat create and resume trading agents. Keep it equal to the web app's setting.
LIVE_TRADING=
# Optional, as on the web app.
# ACCRED_BASE_URL=https://accred.sh
# ROBINHOOD_RPC_URL=
# LIFI_API_KEY=
# COINGECKO_PRO_API_KEY=
# COINGECKO_DEMO_API_KEY=
# PORT=8080
